 {
  "sort_order": 9,
  "chapter_id": "72f4b4d4-6728-4689-beb8-7aaeb33700ef",
  "poziom": "h3",
  "tekst": "Dieta okinawska.",
  "ma_caps": false
 },
 {
  "sort_order": 9,
  "chapter_id": "72f4b4d4-6728-4689-beb8-7aaeb33700ef",
  "poziom": "h2",
  "tekst": "Regularna aktywność fizyczna jest niezbędna.",
  "ma_caps": false
 },
 {
  "sort_order": 9,
  "chapter_id": "72f4b4d4-6728-4689-beb8-7aaeb33700ef",
  "poziom": "h2",
  "tekst": "Podsumowanie – od szczegółów do całości.",
  "ma_caps": false
 },
 {
  "sort_order": 10,
  "chapter_id": "3e0817b1-5c6d-4d42-9f3f-678c26fc0752",
  "poziom": "h1",
  "tekst": "ROZDZIAŁ 8: Suplementacja – co działa, co nie, i jak to robić dobrze.",
  "ma_caps": true
 },
 {
  "sort_order": 10,
  "chapter_id": "3e0817b1-5c6d-4d42-9f3f-678c26fc0752",
  "poziom": "h2",
  "tekst": "WAPŃ – Fundament, ale nie taki prosty.",
  "ma_caps": true
 },
 {
  "sort_order": 10,
  "chapter_id": "3e0817b1-5c6d-4d42-9f3f-678c26fc0752",
  "poziom": "h3",
  "tekst": "Czy w ogóle potrzebujesz suplementu wapnia?",
  "ma_caps": false
 },
 {
  "sort_order": 10,
  "chapter_id": "3e0817b1-5c6d-4d42-9f3f-678c26fc0752",
  "poziom": "h3",
  "tekst": "Które formy wapnia działają najlepiej?",
  "ma_caps": false
 },
 {
  "sort_order": 10,
  "chapter_id": "3e0817b1-5c6d-4d42-9f3f-678c26fc0752",
  "poziom": "h3",
  "tekst": "Jak czytać etykietę suplementu?",
  "ma_caps": false
 },
 {
  "sort_order": 10,
  "chapter_id": "3e0817b1-5c6d-4d42-9f3f-678c26fc0752",
  "poziom": "h3",
  "tekst": "KIEDY brać wapń – to ma znaczenie.",
  "ma_caps": true
 },
 {
  "sort_order": 10,
  "chapter_id": "3e0817b1-5c6d-4d42-9f3f-678c26fc0752",
  "poziom": "h3",
  "tekst": "Czego unikać przy przyjmowaniu wapnia.",
  "ma_caps": false
 },
 {
  "sort_order": 10,
  "chapter_id": "3e0817b1-5c6d-4d42-9f3f-678c26fc0752",
  "poziom": "h2",
  "tekst": "WITAMINA D3 – hormon, nie witamina.",
  "ma_caps": true
 },
 {
  "sort_order": 10,
  "chapter_id": "3e0817b1-5c6d-4d42-9f3f-678c26fc0752",
  "poziom": "h3",
  "tekst": "Ile D3 naprawdę potrzebujesz?",
  "ma_caps": false
 },
 {
  "sort_order": 10,
  "chapter_id": "3e0817b1-5c6d-4d42-9f3f-678c26fc0752",
  "poziom": "h3",
  "tekst": "Jak dobrać dawkę D3 na podstawie badania krwi?",
  "ma_caps": false
 },
 {
  "sort_order": 10,
  "chapter_id": "3e0817b1-5c6d-4d42-9f3f-678c26fc0752",
  "poziom": "h3",
  "tekst": "KIEDY i JAK brać witaminę D3.",
  "ma_caps": true
 },
 {
  "sort_order": 10,
  "chapter_id": "3e0817b1-5c6d-4d42-9f3f-678c26fc0752",
  "poziom": "h2",
  "tekst": "Inne suplementy – co działa, co jest przereklamowane.",
  "ma_caps": false
 },
 {
  "sort_order": 10,
  "chapter_id": "3e0817b1-5c6d-4d42-9f3f-678c26fc0752",
  "poziom": "h3",
  "tekst": "Magnez – potrzebny, ale nie dla każdego.",
  "ma_caps": false
 },
 {
  "sort_order": 10,
  "chapter_id": "3e0817b1-5c6d-4d42-9f3f-678c26fc0752",
  "poziom": "h3",
  "tekst": "Witamina K2 (menachinon-7) – obiecująca, ale dane niejednoznaczne.",
  "ma_caps": false
 },
 {
  "sort_order": 10,
  "chapter_id": "3e0817b1-5c6d-4d42-9f3f-678c26fc0752",
  "poziom": "h3",
  "tekst": "Białko – suplement? Niekoniecznie. Ale musisz mieć go wystarczająco.",
  "ma_caps": false
 },
 {
  "sort_order": 10,
  "chapter_id": "3e0817b1-5c6d-4d42-9f3f-678c26fc0752",
  "poziom": "h3",
  "tekst": "Kolagen – specyficzne białko, które może być „dodatkiem ekstra”.",
  "ma_caps": false
 },
 {
  "sort_order": 10,
  "chapter_id": "3e0817b1-5c6d-4d42-9f3f-678c26fc0752",
  "poziom": "h3",
  "tekst": "Probiotyki – wczesny etap badań.",
  "ma_caps": false
 },
 {
  "sort_order": 10,
  "chapter_id": "3e0817b1-5c6d-4d42-9f3f-678c26fc0752",
  "poziom": "h2",
  "tekst": "Czego NIE suplementować (chyba że masz konkretny niedobór).",
  "ma_caps": true
 },
 {
  "sort_order": 10,
  "chapter_id": "3e0817b1-5c6d-4d42-9f3f-678c26fc0752",
  "poziom": "h2",
  "tekst": "Interakcje – czego NIE łączyć.",
  "ma_caps": true
 },
 {
  "sort_order": 10,
  "chapter_id": "3e0817b1-5c6d-4d42-9f3f-678c26fc0752",
  "poziom": "h2",
  "tekst": "Skutki uboczne suplementacji – czego się spodziewać.",
  "ma_caps": false
 },
 {
  "sort_order": 10,
  "chapter_id": "3e0817b1-5c6d-4d42-9f3f-678c26fc0752",
  "poziom": "h3",
  "tekst": "Wapń.",
  "ma_caps": false
 },
 {
  "sort_order": 10,
  "chapter_id": "3e0817b1-5c6d-4d42-9f3f-678c26fc0752",
  "poziom": "h3",
  "tekst": "Witamina D3.",
  "ma_caps": false
 },
 {
  "sort_order": 10,
  "chapter_id": "3e0817b1-5c6d-4d42-9f3f-678c26fc0752",
  "poziom": "h3",
  "tekst": "Magnez.",
  "ma_caps": false
 },
 {
  "sort_order": 10,
  "chapter_id": "3e0817b1-5c6d-4d42-9f3f-678c26fc0752",
  "poziom": "h3",
  "tekst": "Probiotyki.",
  "ma_caps": false
 },
 {
  "sort_order": 10,
  "chapter_id": "3e0817b1-5c6d-4d42-9f3f-678c26fc0752",
  "poziom": "h2",
  "tekst": "GOTOWY SCHEMAT – Twój dzienny plan suplementacji.",
  "ma_caps": true
 },
 {
  "sort_order": 10,
  "chapter_id": "3e0817b1-5c6d-4d42-9f3f-678c26fc0752",
  "poziom": "h3",
  "tekst": "SCENARIUSZ 1: Jesz około 600–700 mg Ca z diety",
  "ma_caps": true
 },
 {
  "sort_order": 10,
  "chapter_id": "3e0817b1-5c6d-4d42-9f3f-678c26fc0752",
  "poziom": "h3",
  "tekst": "SCENARIUSZ 2: Jesz mniej niż 500 mg Ca z diety",
  "ma_caps": true
 },
 {
  "sort_order": 10,
  "chapter_id": "3e0817b1-5c6d-4d42-9f3f-678c26fc0752",
  "poziom": "h3",
  "tekst": "SCENARIUSZ 3: Masz niedobór witaminy D (poniżej 20 ng/mL)",
  "ma_caps": true
 },
 {
  "sort_order": 10,
  "chapter_id": "3e0817b1-5c6d-4d42-9f3f-678c26fc0752",
  "poziom": "h2",
  "tekst": "Jak monitorować skuteczność?",
  "ma_caps": false
 },
 {
  "sort_order": 10,
  "chapter_id": "3e0817b1-5c6d-4d42-9f3f-678c26fc0752",
  "poziom": "h2",
  "tekst": "PODSUMOWANIE: Co robić teraz?",
  "ma_caps": true
 },
 {
  "sort_order": 11,
  "chapter_id": "ab67bb78-2977-4f95-b199-1c3b56e743b3",
  "poziom": "h1",
  "tekst": "Rozdział 9: Ruch – filar równie ważny jak żywienie.",
  "ma_caps": false
 },
 {
  "sort_order": 11,
  "chapter_id": "ab67bb78-2977-4f95-b199-1c3b56e743b3",
  "poziom": "h2",
  "tekst": "Spójrz na nie, nie przez różowe okulary.",
  "ma_caps": false
 },
 {
  "sort_order": 11,
  "chapter_id": "ab67bb78-2977-4f95-b199-1c3b56e743b3",
  "poziom": "h2",
  "tekst": "Dwa cele, dwa typy ćwiczeń.",
  "ma_caps": false
 },
 {
  "sort_order": 11,
  "chapter_id": "ab67bb78-2977-4f95-b199-1c3b56e743b3",
  "poziom": "h2",
  "tekst": "Dlaczego zapobieganie upadkom jest priorytetem.",
  "ma_caps": false
 },
 {
  "sort_order": 11,
  "chapter_id": "ab67bb78-2977-4f95-b199-1c3b56e743b3",
  "poziom": "h2",
  "tekst": "Jak zmniejszyć ryzyko upadków?",
  "ma_caps": false
 },
 {
  "sort_order": 11,
  "chapter_id": "ab67bb78-2977-4f95-b199-1c3b56e743b3",
  "poziom": "h2",
  "tekst": "Trening równowagi i reaktywnego kroku.",
  "ma_caps": false
 },
 {
  "sort_order": 11,
  "chapter_id": "ab67bb78-2977-4f95-b199-1c3b56e743b3",
  "poziom": "h2",
  "tekst": "Tai chi – więcej niż „łagodna gimnastyka”.",
  "ma_caps": false
 },
 {
  "sort_order": 11,
  "chapter_id": "ab67bb78-2977-4f95-b199-1c3b56e743b3",
  "poziom": "h2",
  "tekst": "Farmakoterapia a upadki.",
  "ma_caps": false
 },
 {
  "sort_order": 11,
  "chapter_id": "ab67bb78-2977-4f95-b199-1c3b56e743b3",
  "poziom": "h2",
  "tekst": "Dlaczego kości potrzebują obciążenia mechanicznego?",
  "ma_caps": false
 },
 {
  "sort_order": 11,
  "chapter_id": "ab67bb78-2977-4f95-b199-1c3b56e743b3",
  "poziom": "h2",
  "tekst": "Pięć zasad skutecznego treningu dla kości.",
  "ma_caps": false
 },
 {
  "sort_order": 11,
  "chapter_id": "ab67bb78-2977-4f95-b199-1c3b56e743b3",
  "poziom": "h2",
  "tekst": "1. Zasada specyficzności.",
  "ma_caps": false
 },
 {
  "sort_order": 11,
  "chapter_id": "ab67bb78-2977-4f95-b199-1c3b56e743b3",
  "poziom": "h2",
  "tekst": "2. Zasada progresywnego obciążenia.",
  "ma_caps": false
 },
 {
  "sort_order": 11,
  "chapter_id": "ab67bb78-2977-4f95-b199-1c3b56e743b3",
  "poziom": "h2",
  "tekst": "3. Zasada odwracalności.",
  "ma_caps": false
 },
 {
  "sort_order": 11,
  "chapter_id": "ab67bb78-2977-4f95-b199-1c3b56e743b3",
  "poziom": "h2",
  "tekst": "4. Zasada wartości początkowych.",
  "ma_caps": false
 },
 {
  "sort_order": 11,
  "chapter_id": "ab67bb78-2977-4f95-b199-1c3b56e743b3",
  "poziom": "h2",
  "tekst": "5. Zasada malejących zysków.",
  "ma_caps": false
 },
 {
  "sort_order": 11,
  "chapter_id": "ab67bb78-2977-4f95-b199-1c3b56e743b3",
  "poziom": "h2",
  "tekst": "„Rest insertion” – krótkie przerwy, większy efekt.",
  "ma_caps": false
 },
 {
  "sort_order": 11,
  "chapter_id": "ab67bb78-2977-4f95-b199-1c3b56e743b3",
  "poziom": "h2",
  "tekst": "Bezpieczeństwo przede wszystkim – czego unikać.",
  "ma_caps": false
 },
 {
  "sort_order": 11,
  "chapter_id": "ab67bb78-2977-4f95-b199-1c3b56e743b3",
  "poziom": "h2",
  "tekst": "Ruchy wysokiego ryzyka.",
  "ma_caps": false
 },
 {
  "sort_order": 11,
  "chapter_id": "ab67bb78-2977-4f95-b199-1c3b56e743b3",
  "poziom": "h2",
  "tekst": "Rola fizjoterapeuty.",
  "ma_caps": false
 },
 {
  "sort_order": 11,
  "chapter_id": "ab67bb78-2977-4f95-b199-1c3b56e743b3",
  "poziom": "h2",
  "tekst": "Lista pytań do fizjoterapeuty.",
  "ma_caps": false
 },
 {
  "sort_order": 11,
  "chapter_id": "ab67bb78-2977-4f95-b199-1c3b56e743b3",
  "poziom": "h2",
  "tekst": "Realistyczne oczekiwania – co ruch zrobi, a czego nie zrobi.",
  "ma_caps": false
 },
 {
  "sort_order": 11,
  "chapter_id": "ab67bb78-2977-4f95-b199-1c3b56e743b3",
  "poziom": "h2",
  "tekst": "Podsumowanie rozdziału 9.",
  "ma_caps": false
 },
 {
  "sort_order": 12,
  "chapter_id": "491479f3-21fe-45ab-a25c-17833d6e9bf6",
  "poziom": "h1",
  "tekst": "ROZDZIAŁ 10: Sen, słońce, stres – pozostałe filary.",
  "ma_caps": true
 },
 {
  "sort_order": 12,
  "chapter_id": "491479f3-21fe-45ab-a25c-17833d6e9bf6",
  "poziom": "h2",
  "tekst": "Sen – więcej niż odpoczynek.",
  "ma_caps": false
 },
 {
  "sort_order": 12,
  "chapter_id": "491479f3-21fe-45ab-a25c-17833d6e9bf6",
  "poziom": "h3",
  "tekst": "Ile snu naprawdę potrzebujesz?",
  "ma_caps": false
 },
 {
  "sort_order": 12,
  "chapter_id": "491479f3-21fe-45ab-a25c-17833d6e9bf6",
  "poziom": "h3",
  "tekst": "Co się dzieje podczas snu?",
  "ma_caps": false
 },
 {
  "sort_order": 12,
  "chapter_id": "491479f3-21fe-45ab-a25c-17833d6e9bf6",
  "poziom": "h3",
  "tekst": "Melatonina – hormon snu i kości.",
  "ma_caps": false
 },
 {
  "sort_order": 12,
  "chapter_id": "491479f3-21fe-45ab-a25c-17833d6e9bf6",
  "poziom": "h3",
  "tekst": "Jak poprawić sen naturalnie.",
  "ma_caps": false
 },
 {
  "sort_order": 12,
  "chapter_id": "491479f3-21fe-45ab-a25c-17833d6e9bf6",
  "poziom": "h3",
  "tekst": "Kiedy rozważyć suplementację melatoniny.",
  "ma_caps": false
 },
 {
  "sort_order": 12,
  "chapter_id": "491479f3-21fe-45ab-a25c-17833d6e9bf6",
  "poziom": "h2",
  "tekst": "Słońce i witamina D – więcej niż tylko kości.",
  "ma_caps": false
 },
 {
  "sort_order": 12,
  "chapter_id": "491479f3-21fe-45ab-a25c-17833d6e9bf6",
  "poziom": "h3",
  "tekst": "Skąd brać witaminę D?",
  "ma_caps": false
 },
 {
  "sort_order": 12,
  "chapter_id": "491479f3-21fe-45ab-a25c-17833d6e9bf6",
  "poziom": "h3",
  "tekst": "Jak działa synteza witaminy D ze słońca?",
  "ma_caps": false
 },
 {
  "sort_order": 12,
  "chapter_id": "491479f3-21fe-45ab-a25c-17833d6e9bf6",
  "poziom": "h3",
  "tekst": "Ile słońca potrzebujesz?",
  "ma_caps": false
 },
 {
  "sort_order": 12,
  "chapter_id": "491479f3-21fe-45ab-a25c-17833d6e9bf6",
  "poziom": "h3",
  "tekst": "Suplementacja bardziej niezawodna niż słońce",
  "ma_caps": false
 },
 {
  "sort_order": 12,
  "chapter_id": "491479f3-21fe-45ab-a25c-17833d6e9bf6",
  "poziom": "h3",
  "tekst": "Zalecenia suplementacyjne",
  "ma_caps": false
 },
 {
  "sort_order": 12,
  "chapter_id": "491479f3-21fe-45ab-a25c-17833d6e9bf6",
  "poziom": "h2",
  "tekst": "Balansowanie korzyści i ryzyka słońca.",
  "ma_caps": false
 },
 {
  "sort_order": 12,
  "chapter_id": "491479f3-21fe-45ab-a25c-17833d6e9bf6",
  "poziom": "h2",
  "tekst": "Stres – jak niszczy Twoje kości.",
  "ma_caps": false
 },
 {
  "sort_order": 12,
  "chapter_id": "491479f3-21fe-45ab-a25c-17833d6e9bf6",
  "poziom": "h3",
  "tekst": "Kortyzol – hormon stresu.",
  "ma_caps": false
 },
 {
  "sort_order": 12,
  "chapter_id": "491479f3-21fe-45ab-a25c-17833d6e9bf6",
  "poziom": "h3",
  "tekst": "Przewlekły stres i zapalenie.",
  "ma_caps": false
 },
 {
  "sort_order": 12,
  "chapter_id": "491479f3-21fe-45ab-a25c-17833d6e9bf6",
  "poziom": "h3",
  "tekst": "Zmiany behawioralne związane ze stresem.",
  "ma_caps": false
 },
 {
  "sort_order": 12,
  "chapter_id": "491479f3-21fe-45ab-a25c-17833d6e9bf6",
  "poziom": "h3",
  "tekst": "Techniki zarządzania stresem – co naprawdę działa?",
  "ma_caps": false
 },
 {
  "sort_order": 12,
  "chapter_id": "491479f3-21fe-45ab-a25c-17833d6e9bf6",
  "poziom": "h3",
  "tekst": "Jak zacząć?",
  "ma_caps": false
 },
 {
  "sort_order": 12,
  "chapter_id": "491479f3-21fe-45ab-a25c-17833d6e9bf6",
  "poziom": "h2",
  "tekst": "Jak te trzy filary się łączą.",
  "ma_caps": false
 },
 {
  "sort_order": 12,
  "chapter_id": "491479f3-21fe-45ab-a25c-17833d6e9bf6",
  "poziom": "h2",
  "tekst": "Praktyczny plan działania – zaczynamy od małych kroków.",
  "ma_caps": false
 },
 {
  "sort_order": 12,
  "chapter_id": "491479f3-21fe-45ab-a25c-17833d6e9bf6",
  "poziom": "h3",
  "tekst": "Tydzień 1: Priorytet sen.",
  "ma_caps": false
 },
 {
  "sort_order": 12,
  "chapter_id": "491479f3-21fe-45ab-a25c-17833d6e9bf6",
  "poziom": "h3",
  "tekst": "Tydzień 2: Dodaj witaminę D.",
  "ma_caps": false
 },
 {
  "sort_order": 12,
  "chapter_id": "491479f3-21fe-45ab-a25c-17833d6e9bf6",
  "poziom": "h3",
  "tekst": "Tydzień 3: Wprowadź zarządzanie stresem.",
  "ma_caps": false
 },
 {
  "sort_order": 12,
  "chapter_id": "491479f3-21fe-45ab-a25c-17833d6e9bf6",
  "poziom": "h3",
  "tekst": "Tydzień 4: Utrzymaj nawyki i ocena.",
  "ma_caps": false
 },
 {
  "sort_order": 12,
  "chapter_id": "491479f3-21fe-45ab-a25c-17833d6e9bf6",
  "poziom": "h3",
  "tekst": "Długoterminowo: Buduj system wsparcia.",
  "ma_caps": false
 },
 {
  "sort_order": 12,
  "chapter_id": "491479f3-21fe-45ab-a25c-17833d6e9bf6",
  "poziom": "h2",
  "tekst": "Podsumowanie rozdziału 11.",
  "ma_caps": false
 },
 {
  "sort_order": 13,
  "chapter_id": "ead59ecf-8e97-4e56-97cc-11a85dd1bb1a",
  "poziom": "h1",
  "tekst": "ZAKOŃCZENIE: Co teraz? I gdzie się spotkamy za kilka lat.",
  "ma_caps": true
 },
