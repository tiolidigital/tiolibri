"""R3 preflight — algorytm liczenia `blocks` ze SPEC §Jak liczymy blocks, dwa warianty kolejnosci.

WARIANT "spec"  = kolejnosc dokladnie taka, jak wypisuje spec v0.4 krok 2:
                  ATX -> MARKER -> BQ -> FENCE -> tabela -> akapit
WARIANT "konsument" = kolejnosc z segmentuj.ts (petla while, gałęzie 1-7):
                  FENCE -> ATX -> tabela -> BQ -> MARKER -> blank -> akapit

Oczekiwanie: oba daja te same liczby na F1-F9, roznia sie na F10/F11.
Porownanie z wyjsciem PRAWDZIWEGO segmentuj() (real.json).
"""
import json
import re
import sys

RE_FENCE_OPEN = re.compile(r"^ {0,3}(`{3,}|~{3,})")
RE_ATX = re.compile(r"^ {0,3}#{1,6}(\s|$)")
RE_TABLE_SEP = re.compile(r"^ {0,3}\|?[ :|-]*-[ :|-]*\|?\s*$")
RE_BQ = re.compile(r"^ {0,3}> ?")
RE_MARKER = re.compile(r"^ {0,3}([-*+]|\d{1,9}[.)])\s")
RE_BLANK = re.compile(r"^\s*$")
INDENT_MIN = 2

is_marker = lambda l: bool(RE_MARKER.match(l))
is_indent2 = lambda l: len(l) - len(l.lstrip(" ")) >= INDENT_MIN
is_blank = lambda l: bool(RE_BLANK.match(l))
starts_block = lambda l: bool(
    RE_FENCE_OPEN.match(l) or RE_ATX.match(l) or RE_BQ.match(l) or is_marker(l)
)


def _scan_lista(lines, i, n):
    j = i
    while True:
        if j + 1 >= n:
            break
        nxt = lines[j + 1]
        if is_marker(nxt) or is_indent2(nxt):
            j += 1
            continue
        if is_blank(nxt):
            k = j + 1
            while k < n and is_blank(lines[k]):
                k += 1
            if k < n and (is_marker(lines[k]) or is_indent2(lines[k])):
                j = k
                continue
            break
        break
    return j


def _scan_akapit(lines, i, n):
    j = i
    while j + 1 < n and not is_blank(lines[j + 1]) and not starts_block(lines[j + 1]):
        j += 1
    return j


def _scan_bq(lines, i, n):
    j = i
    while j + 1 < n and RE_BQ.match(lines[j + 1]):
        j += 1
    return j


def _scan_tabela(lines, i, n):
    j = i + 1
    while j + 1 < n and "|" in lines[j + 1]:
        j += 1
    return j


def _scan_fence(lines, i, n):
    L = lines[i]
    indent = len(L) - len(L.lstrip(" "))
    ch = L[indent]
    ln = 0
    while indent + ln < len(L) and L[indent + ln] == ch:
        ln += 1
    close = re.compile(r"^ {0,3}\%s{%d,}\s*$" % (ch, ln))
    j = i + 1
    while j < n:
        if close.match(lines[j]):
            return j
        j += 1
    return n - 1


def count_blocks(md, order):
    lines = md.split("\n")
    n = len(lines)
    out = {k: 0 for k in ("naglowek", "akapit", "lista", "blockquote", "kod", "tabela")}
    i = 0
    while i < n:
        L = lines[i]
        if is_blank(L):
            i += 1
            continue
        is_tab = "|" in L and i + 1 < n and RE_TABLE_SEP.match(lines[i + 1])
        hit = None
        for branch in order:
            if branch == "fence" and RE_FENCE_OPEN.match(L):
                hit = ("kod", _scan_fence(lines, i, n))
            elif branch == "atx" and RE_ATX.match(L):
                hit = ("naglowek", i)
            elif branch == "tabela" and is_tab:
                hit = ("tabela", _scan_tabela(lines, i, n))
            elif branch == "bq" and RE_BQ.match(L):
                hit = ("blockquote", _scan_bq(lines, i, n))
            elif branch == "marker" and is_marker(L):
                hit = ("lista", _scan_lista(lines, i, n))
            if hit:
                break
        if hit is None:
            hit = ("akapit", _scan_akapit(lines, i, n))
        typ, j = hit
        out[typ] += 1
        i = j + 1
    return {k: v for k, v in out.items() if v}


ORDER_SPEC = ["atx", "marker", "bq", "fence", "tabela"]
ORDER_KONSUMENT = ["fence", "atx", "tabela", "bq", "marker"]

fx = json.load(open(sys.argv[1]))
real = json.load(open(sys.argv[2]))

pas = fail = 0
print("%-30s %-26s %-26s %s" % ("fixture", "prawdziwy segmentuj()", "kolejnosc ze SPECA", "kolejnosc konsumenta"))
for name, md in fx:
    r = {k: v for k, v in real[name].items()}
    s = count_blocks(md, ORDER_SPEC)
    k = count_blocks(md, ORDER_KONSUMENT)
